/target
**/*.rs.bk

# Local runtime data, never committed.
/data
/cache
*.db
*.db-wal
*.db-shm

# Dependencies of the interface. Its build output is committed on purpose:
# the server embeds it, so compiling the binary needs no JavaScript tool.
/web/node_modules

# Local configuration holding real paths and keys.
/melyxar.local.toml
.env

# Working directories of the mutation checks (cargo-mutants).
/mutants.out
/mutants.out.old
