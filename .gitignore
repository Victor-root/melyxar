/target
**/*.rs.bk

# Local runtime data, never committed.
/data
/cache
*.db
*.db-wal
*.db-shm

# Dependencies of the interface, and its build output. The update script
# builds it from source and puts it in the folder the server reads it from,
# so keeping the result here as well would just be a second copy that a
# source only change could leave stale.
/web/node_modules
/web/dist

# Local configuration holding real paths and keys.
/melyxar.local.toml
.env

# Working directories of the mutation checks (cargo-mutants).
/mutants.out
/mutants.out.old
