# The FFmpeg ffmpeg-melyxar is built from, read by build.sh.
#
# Always the latest stable release of FFmpeg. Moving to a newer one is these
# lines: the version, the SHA-256 of its .tar.xz as published on
# ffmpeg.org, and the revision back to 1. The revision counts our own changes
# on one version (a patch added or changed, an option) and is what the
# version string ends with: "9.0.2-melyxar1".
FFMPEG_VERSION="9.0.2"
FFMPEG_SHA256="8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e"
MELYXAR_REVISION="4"

# libplacebo, which the colour conversion through Vulkan is made of, built
# here too because FFmpeg 9 wants a newer one than Debian 13 has. Pinned to
# a release and to the commit that release must be, the build refused when
# the tag no longer points there. Always the latest stable release.
LIBPLACEBO_TAG="v7.360.1"
LIBPLACEBO_COMMIT="cee9b076f2c63104ccfd497fa79c39a867293ec4"
