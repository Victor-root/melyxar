# What ffmpeg-melyxar is built with, one option per line, handed to FFmpeg's
# configure. Only what Melyxar uses: the cards, the encoders it writes with,
# the filters its commands name, and the formats it reads and writes.
#
# libplacebo is the one built by build.sh, found beside the tools. The Vulkan
# filters' shaders are compiled at build time by glslang, named here because
# the tool tries glslc first and gives up on Vulkan's own filters when the
# glslc it finds is too old for them, rather than trying glslang next.
--enable-gpl
--disable-debug
--disable-doc
--disable-ffplay
--enable-vaapi
--enable-libdrm
--enable-vulkan
--enable-libplacebo
--glslc=glslang
--enable-ffnvcodec
--enable-nvenc
--enable-nvdec
--enable-cuvid
--enable-cuda-llvm
--enable-libx264
--enable-libx265
--enable-libsvtav1
--enable-libdav1d
--enable-libzimg
--enable-libass
--enable-libfreetype
--enable-libfontconfig
--enable-libfribidi
--enable-libharfbuzz
--enable-libopus
--enable-libmp3lame
--enable-libvorbis
--enable-libwebp
