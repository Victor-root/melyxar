# What ffmpeg-melyxar is built with, one option per line, handed to FFmpeg's
# configure. Only what Melyxar uses: the cards, the encoders it writes with,
# the filters its commands name, and the formats it reads and writes.
#
# libplacebo is the one built by build.sh, found beside the tools. The Vulkan
# filters' shaders are compiled at build time by glslang, named here because
# the tool tries glslc first and gives up on Vulkan's own filters when the
# glslc it finds is too old for them, rather than trying glslang next.
--enable-gpl
--disable-debug
--disable-doc
--disable-ffplay
--enable-vaapi
--enable-libdrm
--enable-vulkan
--enable-libplacebo
--glslc=glslang
--enable-ffnvcodec
--enable-nvenc
--enable-nvdec
--enable-cuvid
--enable-cuda-llvm
--enable-libx264
--enable-libx265
--enable-libsvtav1
--enable-libdav1d
--enable-libzimg
--enable-libass
--enable-libfreetype
--enable-libfontconfig
--enable-libfribidi
--enable-libharfbuzz
--enable-libopus
--enable-libmp3lame
--enable-libvorbis
--enable-libwebp

# Decoders of formats no media library holds, left out so that a file crafted
# against one of them is a file FFmpeg cannot open rather than a bug it runs.
# They are where the flaws of recent years were found and are the last to be
# fixed upstream (MagicYUV, "PixelSmash", CVE-2026-8461; Flash Screen Video,
# an unfixed memory leak). Kept on purpose although rare: Bink and Smacker
# (game cinematics people keep), Windows Media Screen (old WMV screencasts)
# and Infinity IMM4/IMM5 (some surveillance cameras).
#
# A lossless editing intermediate, never a film anybody watches.
--disable-decoder=magicyuv
# Screen recordings.
--disable-decoder=flashsv
--disable-decoder=flashsv2
--disable-decoder=tscc
--disable-decoder=tscc2
--disable-decoder=mss1
--disable-decoder=msa1
--disable-decoder=g2m
--disable-decoder=cscd
--disable-decoder=rscc
--disable-decoder=screenpresso
--disable-decoder=tdsc
--disable-decoder=vmnc
--disable-decoder=fic
--disable-decoder=mwsc
# The cinematics of 1990s video games and of their engines.
--disable-decoder=arbc
--disable-decoder=sanm
--disable-decoder=bethsoftvid
--disable-decoder=idcin
--disable-decoder=interplay_video
--disable-decoder=vmdvideo
