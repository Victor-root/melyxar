# Copy this file to keystore.properties, in this same folder (android/), and
# fill in the four values: every build is then signed with this key, debug as
# well as release, the Run button of Android Studio included.
#
# keystore.properties and the key itself are ignored by git: they never leave
# the machine that builds.
#
# storeFile     the key file (.jks or .keystore), its full path. On Windows,
#               forward slashes or doubled backslashes: C:/keys/release.jks
# storePassword the password of the key file
# keyAlias      the name of the key inside it (keytool -list -keystore <file>)
# keyPassword   the password of that key, often the same as storePassword
#
# Without this file the build still works, signed with the debug key Android
# Studio makes on each machine.

storeFile=C:/path/to/release-key.jks
storePassword=REPLACE_WITH_YOUR_STORE_PASSWORD
keyAlias=key0
keyPassword=REPLACE_WITH_YOUR_KEY_PASSWORD
