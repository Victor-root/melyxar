<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The ground of the web interface's dark theme, for what the system draws
         before a screen does: the window. -->
    <color name="ground">#0C0D10</color>
    <!-- Behind the launcher icon: white in the system's light theme, the dark
         ground in its dark one, on launchers that read the theme for icons. -->
    <color name="icon_ground">#FFFFFF</color>
</resources>
