<?xml version="1.0" encoding="utf-8"?>
<!-- Before Android 12, the same: nothing of a server's session is backed up. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
