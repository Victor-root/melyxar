<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The music keeps playing with the screen off or the application left,
         from a service in the foreground, without letting the phone sleep
         in the middle of a song it is still fetching. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Asked at the first song: some phones show the card of the music on
         the lock screen only for an application allowed to notify. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Plain http is let through by the system because a server at home
         answers on it; the application itself refuses it outside the home
         network (see server/Address.kt). -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Melyxar"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".connect.ConnectActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Turning the phone, changing its theme or putting the film in a
             window of its own must not reload the interface: the page keeps
             where it is and what it plays. -->
        <activity
            android:name=".web.WebActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true" />

        <!-- Open to the phone's own controllers, the lock screen, a headset,
             a car, which is what a session of music is for: none of them
             holds a permission it could be asked for, and the session itself
             only ever hands their presses to the page. -->
        <service
            android:name=".music.MusicService"
            android:exported="true"
            tools:ignore="ExportedService"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>
</manifest>
