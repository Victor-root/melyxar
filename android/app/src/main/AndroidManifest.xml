<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The music keeps playing with the screen off or the application left,
         from a service in the foreground, without letting the phone sleep
         in the middle of a song it is still fetching. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Asked at the first song: some phones show the card of the music on
         the lock screen only for an application allowed to notify. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Searching by voice listens to the remote's microphone itself,
         through the television's own recogniser, rather than opening the
         recogniser's window over Melyxar's. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Whether the device has something to listen with: since Android 11 an
         application sees only what it names. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- The same application on a television, driven by its remote. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- Searching by voice is a comfort, never a reason not to install. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Plain http is let through by the system because a server at home
         answers on it; the application itself refuses it outside the home
         network (see server/Address.kt). -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/tv_banner_c81e1e"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_full_c81e1e"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Melyxar"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".connect.ConnectActivity"
            android:exported="true" />

