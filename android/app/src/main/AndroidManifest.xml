<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The music keeps playing with the screen off or the application left,
         from a service in the foreground, without letting the phone sleep
         in the middle of a song it is still fetching. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Asked at the first song: some phones show the card of the music on
         the lock screen only for an application allowed to notify. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Whether the device has something to listen with, for searching by
         voice: since Android 11 an application sees only what it names. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <!-- The same application on a television, driven by its remote. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Plain http is let through by the system because a server at home
         answers on it; the application itself refuses it outside the home
         network (see server/Address.kt). -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_light"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Melyxar"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".connect.ConnectActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The door again, once for each icon the phone's launcher can show,
             only one of them on at a time: the logo on white, the one there
             at first, on the dark ground, or alone with nothing behind it,
             chosen in the settings of the interface (web/LauncherIcons.kt). -->
        <activity-alias
            android:name=".connect.IconLight"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_light"
            android:targetActivity=".connect.ConnectActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".connect.IconDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dark"
            android:targetActivity=".connect.ConnectActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".connect.IconClear"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_clear"
            android:targetActivity=".connect.ConnectActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The whole of the application on a television, every screen of it
             drawn natively. -->
        <activity
            android:name=".tv.TvActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|uiMode|screenSize|screenLayout|smallestScreenSize|density"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- The pictures of the works in the television's own Continue
             watching row, read by its home screen, which cannot read the
             server's: only those, and only to read. -->
        <provider
            android:name=".tv.WatchNextPictures"
            android:authorities="${applicationId}.watchnext"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Turning the phone, changing its theme or putting the film in a
             window of its own must not reload the interface: the page keeps
             where it is and what it plays. -->
        <activity
            android:name=".web.WebActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true" />

        <!-- Open to the phone's own controllers, the lock screen, a headset,
             a car, which is what a session of music is for: none of them
             holds a permission it could be asked for, and the session itself
             only ever hands their presses to the page. -->
        <service
            android:name=".music.MusicService"
            android:exported="true"
            tools:ignore="ExportedService"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>
</manifest>
